# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://pruebaiabech.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini

FLASK_SECRET_KEY=jh-consulting-doc-law-dev-key
# dev = pruebas locales | pdn = producción (Azure: LEGAL_ENV=pdn)
LEGAL_ENV=dev
# Opcional: ruta montada que contiene usuarios.csv y tenants/ (sustituye data/{LEGAL_ENV})
# LEGAL_DATA_ROOT=
# URL pública para el pixel en correos (sin /doc-law al final)
# Local: http://127.0.0.1:5050 o túnel cloudflared https://....trycloudflare.com
# Azure: https://bechange-chat-mvp.azurewebsites.net (o omitir: usa WEBSITE_HOSTNAME)
# LEGAL_URL_PREFIX=/doc-law  # solo en Azure / wsgi (sync_and_deploy.ps1 lo pone)
# Local con Selector/run_dev.ps1 → puerto 8000
LEGAL_PUBLIC_BASE_URL=http://127.0.0.1:8000
LEGAL_URL_PREFIX=/doc-law
# Túnel HTTPS para que Gmail registre aperturas en local (cloudflared / ngrok):
# LEGAL_PUBLIC_TUNNEL_URL=https://xxxx.trycloudflare.com
# 1 = no envía SMTP; prueba pixel con enlace en historial
MAIL_DRY_RUN=1

# --- Gmail (recomendado local) ---
# MAIL_FROM=tu_cuenta@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=1
# SMTP_USE_SSL=0
# SMTP_USER=tu_cuenta@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# Contraseña de aplicación: https://myaccount.google.com/apppasswords

# --- Microsoft 365 (alternativa) ---
# MAIL_FROM=notificaciones@tudespacho.com
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_USE_TLS=1

# Envío real: MAIL_DRY_RUN=0

# Google Drive — hconsultingcolombia@gmail.com (memorial + citación .docx)
# La contraseña de aplicación de Gmail NO sirve para Drive; use OAuth o cuenta de servicio.
#
# --- Opción A (recomendada): OAuth con la misma cuenta Gmail ---
# 1) console.cloud.google.com → APIs → Google Drive API
# 2) Credenciales → OAuth → Cliente tipo "Escritorio" → copiar ID y secreto
# 3) Pantalla de consentimiento → usuarios de prueba: hconsultingcolombia@gmail.com
# 4) En .env: CLIENT_ID + CLIENT_SECRET → ejecutar scripts/drive_oauth_setup.py → REFRESH_TOKEN
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# GOOGLE_DRIVE_REFRESH_TOKEN=
# GOOGLE_DRIVE_ROOT_FOLDER_ID=
#
# --- Opción B: cuenta de servicio + carpeta compartida en ese Drive ---
# GOOGLE_DRIVE_CREDENTIALS_JSON=secrets/google-drive-service-account.json
# GOOGLE_DRIVE_ROOT_FOLDER_ID=

# OneDrive / SharePoint (opcional, no usado por defecto)
# ONEDRIVE_SITE_HOST=
# ONEDRIVE_SITE_PATH=
# ONEDRIVE_NOTIF_FOLDER=
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

PORT=5050
